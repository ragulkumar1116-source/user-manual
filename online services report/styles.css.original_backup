/* ==========================================================================
   Aadhav Intech Installation & Service Report Generator Stylesheet
   Supports Installation Reports, Service Reports & Spare Parts Modules
   ========================================================================== */

:root {
  --bg-dark: #0f172a;
  --panel-bg: #1e293b;
  --border-color: #334155;
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --primary: #38bdf8;
  --primary-hover: #0284c7;
  --accent: #818cf8;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  -webkit-tap-highlight-color: transparent;
}

body {
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  background-color: var(--bg-dark);
  color: var(--text-main);
  line-height: 1.5;
  min-height: 100vh;
}

/* Document Fonts */
.font-times {
  font-family: "Times New Roman", Times, serif !important;
}

.font-arial {
  font-family: Arial, Helvetica, sans-serif !important;
}

.font-calibri {
  font-family: Calibri, "Segoe UI", sans-serif !important;
}

/* Header Navigation Bar */
.app-header {
  height: 60px;
  background-color: rgba(30, 41, 59, 0.95);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  position: sticky;
  top: 0;
  z-index: 100;
  gap: 12px;
}

.header-brand {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--primary);
  flex-shrink: 0;
}

.header-brand h1 {
  font-size: 1.05rem;
  font-weight: 700;
  color: #ffffff;
  white-space: nowrap;
}

.mobile-view-toggle {
  display: none;
  background-color: #0f172a;
  padding: 3px;
  border-radius: 6px;
  border: 1px solid var(--border-color);
}

.view-btn {
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 0.78rem;
  padding: 5px 12px;
  border-radius: 4px;
  cursor: pointer;
  font-weight: 600;
}

.view-btn.active {
  background-color: var(--primary);
  color: #0f172a;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.preset-select {
  background-color: #0f172a;
  border: 1px solid var(--border-color);
  color: #ffffff;
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 0.8rem;
  font-weight: 600;
  outline: none;
  cursor: pointer;
}
.preset-select option {
  background-color: #1e293b;
  color: #ffffff;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  border: 1px solid transparent;
  white-space: nowrap;
}

.btn-primary {
  background-color: var(--primary);
  color: #0f172a;
}
.btn-primary:hover {
  background-color: var(--primary-hover);
  color: #ffffff;
}

.btn-secondary {
  background-color: var(--border-color);
  color: var(--text-main);
}
.btn-secondary:hover {
  background-color: #475569;
}

.btn-outline {
  background-color: transparent;
  border-color: var(--border-color);
  color: var(--text-muted);
}
.btn-outline:hover {
  border-color: var(--primary);
  color: var(--primary);
}

.btn-danger-xs {
  background-color: #ef4444;
  color: #ffffff;
  border: none;
  padding: 2px 6px;
  font-size: 0.7rem;
  border-radius: 4px;
  cursor: pointer;
}

.btn-xs {
  padding: 4px 10px;
  font-size: 0.72rem;
  background-color: #334155;
  color: #cbd5e1;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}
.btn-xs:hover {
  background-color: #475569;
}

/* Layout */
.app-layout {
  display: flex;
  min-height: calc(100vh - 60px);
}

.editor-panel {
  width: 440px;
  background-color: var(--panel-bg);
  border-right: 1px solid var(--border-color);
  padding: 20px;
  overflow-y: auto;
  max-height: calc(100vh - 60px);
}

.editor-header h2 {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text-main);
}
.editor-header p {
  font-size: 0.78rem;
  color: var(--text-muted);
  margin-bottom: 16px;
}

.form-section {
  background-color: rgba(15, 23, 42, 0.5);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 14px;
  margin-bottom: 14px;
}

.form-section h3 {
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--primary);
}

.form-group {
  margin-bottom: 10px;
}
.form-group:last-child {
  margin-bottom: 0;
}

.form-row {
  display: flex;
  gap: 10px;
}
.form-row .form-group {
  flex: 1;
}

label {
  display: block;
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--text-muted);
  margin-bottom: 4px;
}

input[type="text"],
input[type="email"],
textarea,
.form-control-select {
  width: 100%;
  padding: 8px 10px;
  background-color: #0f172a;
  border: 1px solid var(--border-color);
  border-radius: 5px;
  color: #ffffff;
  font-size: 0.85rem;
  outline: none;
  transition: border-color 0.2s;
}

input[type="text"]:focus,
input[type="email"]:focus,
textarea:focus,
.form-control-select:focus {
  border-color: var(--primary);
}

textarea {
  resize: vertical;
  font-family: inherit;
}

.checkbox-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
  margin-bottom: 10px;
}

.checkbox-label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.78rem;
  color: var(--text-main);
  cursor: pointer;
}

.checkbox-label input[type="checkbox"] {
  width: 16px;
  height: 16px;
  accent-color: var(--primary);
  cursor: pointer;
}

.chargeable-block {
  border-top: 1px dashed var(--border-color);
  padding-top: 8px;
}

/* Spare Part Row Inputs in Form Editor */
.spare-item-row {
  background-color: #0f172a;
  border: 1px solid var(--border-color);
  border-radius: 6px;
  padding: 8px;
  margin-bottom: 8px;
}
.spare-item-row .row-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.72rem;
  color: var(--text-muted);
  margin-bottom: 6px;
}
.spare-item-row .row-inputs {
  display: flex;
  gap: 6px;
  margin-bottom: 6px;
}
.spare-item-row .row-checks {
  display: flex;
  gap: 12px;
}

/* Signatures */
.signature-input-box {
  margin-bottom: 14px;
}
.signature-input-box h4 {
  font-size: 0.78rem;
  color: var(--text-main);
  margin-bottom: 4px;
}

.signature-tabs {
  display: flex;
  gap: 4px;
  margin-bottom: 6px;
}

.tab-btn {
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 0.72rem;
  padding: 3px 8px;
  cursor: pointer;
  border-radius: 4px;
}
.tab-btn.active {
  background-color: var(--primary);
  color: #0f172a;
  font-weight: 600;
}

.tab-content {
  display: none;
}
.tab-content.active {
  display: block;
}

canvas {
  background-color: #ffffff;
  border-radius: 4px;
  cursor: crosshair;
  touch-action: none;
  width: 100%;
  max-width: 300px;
  height: 90px;
}

input[type="file"] {
  font-size: 0.72rem;
  color: var(--text-muted);
}

/* Right Live Preview Panel */
.preview-panel {
  flex: 1;
  background-color: #080c14;
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow-y: auto;
  overflow-x: hidden;
}

.preview-bar {
  width: 100%;
  max-width: 210mm;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  color: var(--text-muted);
  font-size: 0.8rem;
}

.preview-badge {
  background-color: rgba(56, 189, 248, 0.1);
  color: var(--primary);
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 0.72rem;
  font-weight: 600;
  border: 1px solid rgba(56, 189, 248, 0.2);
}

.a4-wrapper {
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6);
  transform-origin: top center;
  transition: transform 0.2s ease;
}

/* ==========================================================================
   EXACT A4 DOCUMENT PRINT ENGINE STYLES
   ========================================================================== */
.a4-document {
  width: 210mm;
  min-height: 297mm;
  padding: 10mm 14mm 12mm 14mm;
  background-color: #ffffff;
  color: #000000;
  font-size: 11pt;
  line-height: 1.3;
  box-sizing: border-box;
  position: relative;
}

.doc-header {
  text-align: center;
  margin-bottom: 4px;
}

.doc-header .company-name {
  font-size: 16pt;
  font-weight: bold;
  letter-spacing: 0.5px;
  color: #000000;
  margin-bottom: 2px;
}

.doc-header .company-address,
.doc-header .company-contact,
.doc-header .company-email {
  font-size: 9pt;
  color: #000000;
  line-height: 1.3;
}

.doc-header .company-email a {
  color: #0000ff;
  text-decoration: underline;
}

.report-title {
  text-align: center;
  font-size: 12.5pt;
  font-weight: bold;
  margin: 8px 0 6px 0;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.report-table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 6px;
  font-size: 10.5pt;
}

.report-table th,
.report-table td {
  border: 1px solid #000000;
  padding: 2.5px 6px;
  vertical-align: top;
}

.cust-table th.th-cust-title {
  text-align: left;
  width: 58%;
  font-weight: bold;
  font-size: 11pt;
}

.cust-table th.th-date-title {
  text-align: right;
  width: 42%;
  font-weight: bold;
  font-size: 11pt;
}

.cust-table td.col-left {
  width: 58%;
}

.cust-table td.col-right {
  width: 42%;
}

.cust-table .lbl {
  font-size: 10.5pt;
  color: #000000;
}

.cust-table .val-bold {
  font-weight: bold;
  font-size: 10.5pt;
}

.cust-table .val {
  font-size: 10pt;
}

.cust-table .lbl-inline {
  font-size: 10.5pt;
}

.cust-table .val-inline {
  font-size: 10.5pt;
  margin-left: 4px;
}

.inst-table th.th-center {
  text-align: center;
  font-weight: bold;
  font-size: 11pt;
}

.inst-table .cell-label {
  width: 160px;
  font-size: 10.5pt;
}

.inst-table .cell-val-bold {
  font-weight: bold;
  font-size: 10.5pt;
}

.inst-table .cell-val {
  font-size: 10.5pt;
}

.service-block {
  border: 1px solid #000000;
  padding: 5px 8px;
  margin-bottom: 6px;
}

.service-block .block-title {
  text-align: center;
  font-weight: bold;
  font-size: 11pt;
  margin-bottom: 6px;
}

.service-checkboxes-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 10.5pt;
  margin-bottom: 6px;
  padding: 0 6px;
}

.chk-item {
  display: inline-flex;
  align-items: center;
}

.chk-box {
  font-size: 12pt;
  line-height: 1;
  font-family: "Segoe UI Symbol", "Arial Unicode MS", sans-serif;
  margin-right: 4px;
}

.service-chargeable-row {
  font-size: 10.5pt;
  padding: 0 6px;
  display: flex;
  align-items: center;
}

.underline-amount {
  text-decoration: underline;
  margin-left: 4px;
}

.regards-block {
  border: 1px solid #000000;
  padding: 3px 6px;
  margin-bottom: 6px;
}

.nested-table {
  width: 100%;
  border-collapse: collapse;
}

.nested-table td {
  border: none;
  padding: 2px 4px;
}

.td-regards-lbl {
  font-weight: bold;
  font-size: 10.5pt;
  width: 140px;
}

.td-regards-val {
  font-size: 10.5pt;
}

.action-block {
  border: 1px solid #000000;
  padding: 6px 8px;
  margin-bottom: 6px;
  min-height: 140px;
}

.block-subheading {
  font-weight: bold;
  font-size: 10.5pt;
  margin-bottom: 4px;
}

.action-content {
  font-size: 10pt;
  line-height: 1.4;
  white-space: pre-wrap;
  text-align: justify;
}

/* Spare Parts Table Module */
.spares-block {
  border: 1px solid #000000;
  margin-bottom: 6px;
}

.spares-title-header {
  text-align: center;
  font-weight: bold;
  font-size: 11pt;
  padding: 3px;
  border-bottom: 1px solid #000000;
}

.spares-table {
  margin-bottom: 0;
}
.spares-table th {
  text-align: center;
  font-weight: bold;
  font-size: 10pt;
  background-color: #f8fafc;
}
.spares-table td {
  font-size: 9.5pt;
  text-align: center;
}
.spares-table td.td-left {
  text-align: left;
}

.remark-block {
  border: 1px solid #000000;
  padding: 6px 8px;
  margin-bottom: 10px;
  min-height: 70px;
}

.remark-content {
  font-size: 10pt;
  line-height: 1.4;
  white-space: pre-wrap;
}

.signature-section-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border: 1px solid #000000;
  min-height: 100px;
}

.sig-box {
  padding: 6px 8px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.sig-left {
  border-right: 1px solid #000000;
}

.sig-top-label {
  font-size: 10pt;
  text-align: left;
  margin-bottom: 2px;
}

.sig-bottom-label {
  font-size: 10pt;
  margin-top: auto;
}

.sig-image-container {
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sig-image-container img {
  max-height: 100%;
  max-width: 100%;
  object-fit: contain;
}

/* Responsive Media Queries */
@media screen and (max-width: 992px) {
  .app-header {
    padding: 0 12px;
  }
  .header-brand h1 {
    font-size: 0.95rem;
  }
  .mobile-view-toggle {
    display: flex;
  }
  .editor-panel {
    width: 100%;
    max-height: none;
    border-right: none;
    padding: 16px;
  }
  .preview-panel {
    width: 100%;
    padding: 12px;
  }
  .editor-panel.mobile-hidden {
    display: none !important;
  }
  .preview-panel.mobile-hidden {
    display: none !important;
  }
}

@media screen and (max-width: 640px) {
  .app-header {
    flex-wrap: wrap;
    height: auto;
    padding: 10px 12px;
  }
  .header-brand {
    order: 1;
  }
  .mobile-view-toggle {
    order: 2;
  }
  .header-actions {
    order: 3;
    width: 100%;
    justify-content: space-between;
    margin-top: 6px;
  }
  .form-row {
    flex-direction: column;
    gap: 0;
  }
}

/* Print Rules */
@media print {
  @page {
    size: A4 portrait;
    margin: 0;
  }

  html, body {
    width: 210mm;
    height: 297mm;
    background: #ffffff !important;
    color: #000000 !important;
    overflow: hidden;
  }

  .no-print {
    display: none !important;
  }

  .app-layout {
    display: block !important;
    min-height: auto !important;
  }

  .editor-panel {
    display: none !important;
  }

  .preview-panel {
    display: block !important;
    padding: 0 !important;
    background: none !important;
    overflow: visible !important;
  }

  .a4-wrapper {
    box-shadow: none !important;
    transform: none !important;
  }

  .a4-document {
    width: 210mm !important;
    min-height: 297mm !important;
    height: 297mm !important;
    padding: 10mm 14mm 12mm 14mm !important;
    box-sizing: border-box !important;
    page-break-after: avoid;
    page-break-inside: avoid;
  }

  .spares-table th {
    background-color: #ffffff !important;
  }
}
